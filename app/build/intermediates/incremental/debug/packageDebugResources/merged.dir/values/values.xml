<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1289F0</color>
    <string name="accessibility_desc">MoeText 需要无障碍权限来读取并改写聊天输入框中的文本。服务仅监听 QQ 的输入框事件，本应用不联网、不上传、不收集任何数据。</string>
    <string name="app_name">MoeText</string>
    <string name="warning_text">使用提示：本工具通过系统无障碍服务自动改写您发出的消息，可能违反目标应用的用户协议，存在被限制或封禁账号的风险。请自行评估后使用。本项目与腾讯无关。</string>
    <style name="Theme.MoeText" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F4F6F8</item>
        <item name="android:navigationBarColor">#F4F6F8</item>
        <item name="android:windowBackground">#F4F6F8</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>